// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  /// Null for an account that signs in with a passkey and has connected no wallet.
  radixAddress    String?   @unique @map("radix_address")
  personaAddress  String?   @map("persona_address")
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  passkeys        UserPasskey[]
  chatMessages    ChatMessage[]
  chatFlags       ChatFlag[]
  webhooks        Webhook[]
  telegramLinks   TelegramLink[]
  notifications       Notification[] @relation("notifications")
  actedNotifications  Notification[] @relation("actedNotifications")

  @@map("users")
}

/// A passkey a user signs in with. `Passkey` is the admin door's (passkey.prisma).
model UserPasskey {
  id         String   @id // the credential id, base64url
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey  Bytes    @map("public_key")
  counter    Int
  transports String[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_passkeys")
}


model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Challenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("challenges")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   // 'page_edited' | 'chat_mention' | 'chat_reply'
  actorId   String   @map("actor_id")
  /// A "WikiPage" id, without a relation: the shipped WikiPage model cannot carry
  /// the back-relation. Null for one from the wiki's own trollbox room.
  pageId    String?  @map("page_id")
  /// The trollbox line a mention or a reply was made in.
  chatMessageId Int? @map("chat_message_id")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user  User @relation("notifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("actedNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Webhook {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  secret        String
  events        String[]
  tagPathFilter String?  @map("tag_path_filter")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("webhooks")
}

model TelegramLink {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  events    String[] @default(["page.created", "page.updated"])
  tagPath   String   @default("") @map("tag_path")
  pageSlug  String   @default("") @map("page_slug")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, tagPath, pageSlug])
  @@index([active])
  @@map("telegram_links")
}


/// One UTC day of user transactions, summed from the Gateway's transaction stream by
/// src/lib/radix/activity.ts. A row exists only once its whole day has been read, so a
/// missing day is unread, never zero.
model LedgerDay {
  day            DateTime @id @db.Date
  transactions   Int
  activeAccounts Int      @map("active_accounts")
  newAccounts    Int      @map("new_accounts")
  newComponents  Int      @map("new_components")
  newResources   Int      @map("new_resources")
  nftsMinted     Int      @map("nfts_minted")
  feesXrd        Float    @map("fees_xrd")
  burnedXrd      Float    @map("burned_xrd")
  royaltiesXrd   Float    @map("royalties_xrd")
  /// The last transaction counted. Null on a day with none, such as during the August 2026 halt.
  stateVersion   Int?     @map("state_version")

  @@map("ledger_days")
}

/// A deleted page as it stood, with every revision, so its history can still
/// restore it: `deletePage` writes it, and `restoreRevision` puts the page and
/// its revisions back under their own ids and drops it. Keyed by the page's id.
model DeletedPage {
  id        String   @id
  tagPath   String   @map("tag_path")
  slug      String
  /// The "WikiPage" row, its generated search column left out.
  page      Json
  /// Its "WikiRevision" rows, oldest first.
  revisions Json
  deletedBy String?  @map("deleted_by")
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@index([tagPath, slug, deletedAt])
  @@map("deleted_pages")
}
