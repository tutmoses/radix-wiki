// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  radixAddress    String    @unique @map("radix_address")
  personaAddress  String?   @map("persona_address")
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  comments        Comment[]
  webhooks        Webhook[]
  telegramLinks   TelegramLink[]
  notifications       Notification[] @relation("notifications")
  actedNotifications  Notification[] @relation("actedNotifications")

  @@map("users")
}



model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Challenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("challenges")
}

model Comment {
  id        String    @id @default(cuid())
  /// A "WikiPage" id. No relation: the shipped model cannot carry the back-relation,
  /// so deleting a page deletes its comments in the app (`deletePage`).
  pageId    String    @map("page_id")
  parentId  String?   @map("parent_id")
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Replies")
  content   String
  authorId  String    @map("author_id")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  @@index([pageId])
  @@index([pageId, parentId])
  @@index([authorId])
  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   // 'comment_on_page' | 'comment_reply' | 'page_edited'
  actorId   String   @map("actor_id")
  /// A "WikiPage" id, without a relation for the reason Comment.pageId gives.
  pageId    String   @map("page_id")
  commentId String?  @map("comment_id")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user  User @relation("notifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("actedNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Webhook {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  secret        String
  events        String[]
  tagPathFilter String?  @map("tag_path_filter")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("webhooks")
}

model TelegramLink {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String   @map("chat_id")
  events    String[] @default(["page.created", "page.updated", "comment.created"])
  tagPath   String   @default("") @map("tag_path")
  pageSlug  String   @default("") @map("page_slug")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, tagPath, pageSlug])
  @@index([active])
  @@map("telegram_links")
}


/// One UTC day of user transactions, summed from the Gateway's transaction stream by
/// src/lib/radix/activity.ts. A row exists only once its whole day has been read, so a
/// missing day is unread, never zero.
model LedgerDay {
  day            DateTime @id @db.Date
  transactions   Int
  activeAccounts Int      @map("active_accounts")
  newAccounts    Int      @map("new_accounts")
  newComponents  Int      @map("new_components")
  newResources   Int      @map("new_resources")
  nftsMinted     Int      @map("nfts_minted")
  feesXrd        Float    @map("fees_xrd")
  burnedXrd      Float    @map("burned_xrd")
  royaltiesXrd   Float    @map("royalties_xrd")
  /// The last transaction counted. Null on a day with none, such as during the August 2026 halt.
  stateVersion   Int?     @map("state_version")

  @@map("ledger_days")
}
